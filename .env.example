# Frontend (Vite, public — anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend / Edge Functions (server-side only — NEVER commit real values)
OPENAQ_API_KEY=your-openaq-api-key
SUPABASE_URL=https://your-project.supabase.co
# service_role: lo consumen las Edge Functions Y los helpers de la suite E2E
# (feature 003) en el proceso de test de Node. Nunca llega al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
