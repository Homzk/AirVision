# Valores DUMMY solo para los unit tests (Vitest corre en modo `test`).
# No son secretos: `src/lib/supabase.ts` exige estas env al importarse, así que
# los tests que tocan el cliente necesitan placeholders válidos. Nunca se usan
# contra Supabase real ni llegan al build de producción / e2e.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=dummy-anon-key-for-tests
